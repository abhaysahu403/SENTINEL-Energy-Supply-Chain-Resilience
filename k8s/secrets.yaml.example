# ============================================================
# SENTINEL SECRETS - EXAMPLE FILE
# ============================================================
# 
# IMPORTANT SECURITY NOTICE:
# This is an EXAMPLE file showing the structure of secrets.
# DO NOT commit actual secrets to version control!
# 
# To create actual secrets:
# 1. Copy this file: cp secrets.yaml.example secrets.yaml
# 2. Replace all placeholder values with real credentials
# 3. Encode values in base64: echo -n "your-value" | base64
# 4. Apply: kubectl apply -f secrets.yaml
# 5. Add secrets.yaml to .gitignore
# 
# ============================================================

apiVersion: v1
kind: Secret
metadata:
  name: sentinel-secrets
  namespace: sentinel
  labels:
    app: sentinel
type: Opaque
data:
  # Database URL (PostgreSQL)
  # Example: postgresql://sentinel:password@postgres.sentinel.svc.cluster.local:5432/sentinel
  # Base64 encoded value
  database-url: cG9zdGdyZXNxbDovL3NlbnRpbmVsOnBhc3N3b3JkQHBvc3RncmVzLnNlbnRpbmVsLnN2Yy5jbHVzdGVyLmxvY2FsOjU0MzIvc2VudGluZWw=
  
  # Neo4j Credentials
  # Username: neo4j (base64: bmVvNGo=)
  neo4j-user: bmVvNGo=
  # Password: change-me-in-production (base64: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=)
  neo4j-password: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
  
  # JWT Secret for authentication
  # Generate: openssl rand -base64 32 | tr -d '\n' | base64
  # Example: change-me-in-production-use-random-string
  jwt-secret: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24tdXNlLXJhbmRvbS1zdHJpbmc=
  
  # External API Keys (Optional - can be empty)
  # EIA API Key - Get from: https://www.eia.gov/opendata/register.php
  eia-api-key: ""
  
  # MarineTraffic API Key - Commercial service
  marinetraffic-api-key: ""

---
# ============================================================
# INSTRUCTIONS TO CREATE ACTUAL SECRETS
# ============================================================
#
# Method 1: Using kubectl create secret
# ----------------------------------------
# kubectl create secret generic sentinel-secrets \
#   --namespace=sentinel \
#   --from-literal=database-url='postgresql://user:pass@host:5432/db' \
#   --from-literal=neo4j-user='neo4j' \
#   --from-literal=neo4j-password='your-password' \
#   --from-literal=jwt-secret='your-jwt-secret' \
#   --from-literal=eia-api-key='your-eia-key' \
#   --from-literal=marinetraffic-api-key='your-mt-key'
#
# Method 2: Using Azure Key Vault (Recommended for AKS)
# -------------------------------------------------------
# 1. Create Key Vault:
#    az keyvault create --name sentinel-kv --resource-group sentinel-rg
#
# 2. Store secrets:
#    az keyvault secret set --vault-name sentinel-kv --name database-url --value "postgresql://..."
#    az keyvault secret set --vault-name sentinel-kv --name jwt-secret --value "..."
#
# 3. Use Azure Key Vault Provider for Secrets Store CSI Driver:
#    https://learn.microsoft.com/en-us/azure/aks/csi-secrets-store-driver
#
# Method 3: Using Sealed Secrets (GitOps-friendly)
# -------------------------------------------------
# 1. Install Sealed Secrets controller
# 2. Create secret and seal it:
#    kubectl create secret generic sentinel-secrets --dry-run=client -o yaml | \
#      kubeseal -o yaml > sealed-secrets.yaml
# 3. Commit sealed-secrets.yaml to git
#
# ============================================================
