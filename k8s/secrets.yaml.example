# ============================================================
# SENTINEL SECRETS - EXAMPLE FILE (QuickStart Mode)
# ============================================================
# 
# For QuickStart deployment, we only need the JWT secret.
# No PostgreSQL, Neo4j, or Kafka credentials needed!
# 
# To create actual secrets:
# kubectl create secret generic sentinel-secrets \
#   --namespace=sentinel \
#   --from-literal=jwt-secret='your-random-jwt-secret-here'
# 
# Or generate a secure JWT secret:
# openssl rand -base64 32
# 
# ============================================================

apiVersion: v1
kind: Secret
metadata:
  name: sentinel-secrets
  namespace: sentinel
  labels:
    app: sentinel
type: Opaque
data:
  # JWT Secret for authentication
  # Generate with: echo -n "$(openssl rand -base64 32)" | base64
  # Example below is base64 encoded "dev-secret-change-in-production"
  jwt-secret: ZGV2LXNlY3JldC1jaGFuZ2UtaW4tcHJvZHVjdGlvbg==
