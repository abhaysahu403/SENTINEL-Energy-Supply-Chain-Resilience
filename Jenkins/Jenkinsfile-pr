@Library('sentinel-library') _

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGE_NAME = "sentinel-backend"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                cd backend
                python -m pip install --upgrade pip
                pip install -r requirements.txt
                '''
            }
        }

        stage('Lint') {
            steps {
                sh '''
                pip install flake8
                flake8 backend/app
                '''
            }
        }

        stage('Unit Test') {
            steps {
                sh '''
                cd backend
                pytest
                '''
            }
        }

        stage('Docker Build Backend') {
            steps {
                sh '''
                docker build -t ${IMAGE_NAME}:pr-${BUILD_NUMBER} -f backend/Dockerfile .
                '''
            }
        }

        stage('Docker Build Frontend') {
            steps {
                sh '''
                docker build -t sentinel-frontend:pr-${BUILD_NUMBER} -f frontend/Dockerfile ./frontend
                '''
            }
        }

    }

    post {

        success {
            echo "PR Validation Passed"
        }

        failure {
            echo "PR Validation Failed"
        }

        always {
            cleanWs()
        }

    }
}