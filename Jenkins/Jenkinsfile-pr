@Library('sentinel-library') _

pipeline {
    agent any
    
    tools {
        // Use Python 3 - configure this in Jenkins Global Tool Configuration
        // Or we'll use direct commands
    }

    options {
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGE_NAME = "sentinel-backend"
        PYTHON_CMD = 'python3'  // Change to 'python' if that's what's available
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Python') {
            steps {
                script {
                    // Try to find Python
                    sh '''
                    echo "Checking for Python..."
                    if command -v python3 &> /dev/null; then
                        echo "Using python3"
                        python3 --version
                    elif command -v python &> /dev/null; then
                        echo "Using python"
                        python --version
                    else
                        echo "ERROR: Python not found!"
                        exit 1
                    fi
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                cd backend
                python3 -m pip install --upgrade pip || python -m pip install --upgrade pip
                python3 -m pip install -r requirements.txt || python -m pip install -r requirements.txt
                '''
            }
        }

        stage('Lint') {
            steps {
                sh '''
                python3 -m pip install flake8 || python -m pip install flake8
                flake8 backend/app
                '''
            }
        }

        stage('Unit Test') {
            steps {
                sh '''
                cd backend
                python3 -m pytest || python -m pytest
                '''
            }
        }

        stage('Docker Build Backend') {
            steps {
                sh '''
                docker build -t ${IMAGE_NAME}:pr-${BUILD_NUMBER} -f backend/Dockerfile .
                '''
            }
        }

        stage('Docker Build Frontend') {
            steps {
                sh '''
                docker build -t sentinel-frontend:pr-${BUILD_NUMBER} -f frontend/Dockerfile ./frontend
                '''
            }
        }

    }

    post {

        success {
            echo "✅ PR Validation Passed"
        }

        failure {
            echo "❌ PR Validation Failed"
        }

        always {
            cleanWs()
        }

    }
}