@Library('sentinel-library') _

pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGE_NAME = "sentinel-backend"
        PYTHON_PATH = "C:\\Users\\HP\\AppData\\Local\\Programs\\Python\\Python311\\python.exe"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Python') {
            steps {
                script {
                    // Check Python on Windows
                    bat '''
                    echo Python Path: %PYTHON_PATH%
                    "%PYTHON_PATH%" --version
                    '''
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                bat '''
                cd backend
                "%PYTHON_PATH%" -m pip install --upgrade pip
                "%PYTHON_PATH%" -m pip install -r requirements.txt
                '''
            }
        }

        stage('Lint') {
            steps {
                bat '''
                "%PYTHON_PATH%" -m pip install flake8
                "%PYTHON_PATH%" -m flake8 backend/app
                '''
            }
        }

        stage('Unit Test') {
            steps {
                bat '''
                cd backend
                "%PYTHON_PATH%" -m pytest
                '''
            }
        }

        stage('Docker Build Backend') {
            steps {
                bat '''
                docker build -t %IMAGE_NAME%:pr-%BUILD_NUMBER% -f backend/Dockerfile .
                '''
            }
        }

        stage('Docker Build Frontend') {
            steps {
                bat '''
                docker build -t sentinel-frontend:pr-%BUILD_NUMBER% -f frontend/Dockerfile ./frontend
                '''
            }
        }

    }

    post {

        success {
            echo "✅ PR Validation Passed"
        }

        failure {
            echo "❌ PR Validation Failed"
        }

        always {
            cleanWs()
        }

    }
}