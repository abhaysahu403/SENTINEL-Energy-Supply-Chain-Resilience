*.swp
*.swo
*~

# ============= SECURITY =============
# API Keys and secrets (CRITICAL)
*.key
*.pem
*.p12
*.pfx
secrets/
.secrets/
credentials.json
service-account.json

# Environment files with sensitive data
.env.production
.env.*.production

# ============= DEPLOYMENT =============
# Kubernetes secrets
k8s/secrets/
*.secret.yaml

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# ============= TEMPORARY FILES =============
# General temporary files
tmp/
temp/
*.tmp
*.bak
*.backup
*.orig

# ============= APPLICATION SPECIFIC =============
# SENTINEL backend
backend/sentinel.db
backend/app/**/*.pyc
backend/.pytest_cache/

# SENTINEL frontend build artifacts
frontend/dist/
frontend/build/
frontend/.vite/
frontend/node_modules/

# Data files (if they're large or generated - uncomment if needed)
# data/*.csv
# data/*.json
# data/*.parquet

# ============= CI/CD =============
# GitHub Actions artifacts
.github/workflows/*.log

# ============= MONITORING / OBSERVABILITY =============
